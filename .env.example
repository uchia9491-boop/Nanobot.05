
# Configuracao do NANO BOT

NODE_ENV=production

# Identificador WhatsApp do administrador
# Preencher posteriormente com o identificador correto
ADMIN_WHATSAPP_ID=

# Pasta para guardar a sessao do WhatsApp
SESSION_DIR=auth_info

# Porta para o servidor, se necessaria
PORT=3000

# Idioma principal do OCR
OCR_LANGUAGES=por+eng
